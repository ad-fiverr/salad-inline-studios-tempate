# Runtime defaults from Dockerfile. Override in the Salad Container Group if needed.
INLINE_HOST=::
INLINE_PORT=8848

ENABLE_JUPYTER=0
ENABLE_FILEBROWSER=0

MIN_MBPS=60

HF_XET_HIGH_PERFORMANCE=0
HF_XET_FIXED_DOWNLOAD_CONCURRENCY=2
HF_XET_DATA_MAX_CONCURRENT_FILE_DOWNLOADS=1
INLINE_HF_SNAPSHOT_MAX_WORKERS=2

# Optional. Set as a Salad Secret only when a gated/private Hugging Face model needs it.
HF_TOKEN=

# Optional. Used only by the manual salad-download-probes diagnostic; not needed to start Inline Studio.
SALAD_GATEWAY_URL=
